{
  "name": "@ziply/cli",
  "version": "0.1.0",
  "description": "Command line utilities for Ziply.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eklavya-raj/ziply.git",
    "directory": "packages/ziply-cli"
  },
  "homepage": "https://github.com/eklavya-raj/ziply#readme",
  "bugs": {
    "url": "https://github.com/eklavya-raj/ziply/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ziply": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "postbuild": "chmod +x dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ziply": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
